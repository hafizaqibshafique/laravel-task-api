{
      "name": "aqibshafique/laravel-task-api",
      "type": "project",
      "description": "A small Laravel REST API for task management with Sanctum auth, form requests, resources, and feature tests.",
      "license": "MIT",
      "require": {
                "php": "^8.2",
                "laravel/framework": "^11.0",
                "laravel/sanctum": "^4.0"
      },
      "require-dev": {
                "phpunit/phpunit": "^11.0",
                "fakerphp/faker": "^1.23"
      },
      "autoload": {
                "psr-4": {
                              "App\\": "app/"
                }
      },
      "autoload-dev": {
                "psr-4": {
                              "Tests\\": "tests/"
                }
      },
      "scripts": {
                "test": "phpunit"
      },
      "minimum-stability": "stable",
      "prefer-stable": true
}
